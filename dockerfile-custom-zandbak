ARG BASE_TAG="develop"
ARG BASE_IMAGE="core-ubuntu-focal"
FROM corentinth/it-tools AS it-tools
FROM kasmweb/$BASE_IMAGE:$BASE_TAG
USER root

ENV HOME /home/kasm-default-profile
ENV STARTUPDIR /dockerstartup
ENV INST_SCRIPTS $STARTUPDIR/install
WORKDIR $HOME

######### Customize Container Here ###########

RUN apt-get update && apt-get upgrade -y
# Install Archive manager
RUN apt-get install -y file-roller unzip inotify-tools

# Install Sudo
RUN apt-get install -y sudo && echo 'kasm-user ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers && rm -rf /var/lib/apt/list/*

# Add Custom Background
ADD /zandbak_background.png  /usr/share/backgrounds/bg_default.png

# Install Remnux Utils
#COPY ./src/ubuntu/install/remnux $INST_SCRIPTS/remnux/
#RUN bash $INST_SCRIPTS/remnux/install_remnux.sh && rm -rf $INST_SCRIPTS/remnux/

# Install Brave
COPY ./src/ubuntu/install/brave $INST_SCRIPTS/brave/
RUN bash $INST_SCRIPTS/brave/install_brave.sh  && rm -rf $INST_SCRIPTS/brave/

# COPY ./src/ubuntu/install/brave/custom_startup.sh $STARTUPDIR/custom_startup.sh
# RUN chmod +x $STARTUPDIR/custom_startup.sh

# Install Google Chrome
COPY ./src/ubuntu/install/chrome $INST_SCRIPTS/chrome/
RUN bash $INST_SCRIPTS/chrome/install_chrome.sh  && rm -rf $INST_SCRIPTS/chrome/

# Security modifications
# COPY ./src/ubuntu/install/misc/single_app_security.sh $INST_SCRIPTS/misc/
# RUN  bash $INST_SCRIPTS/misc/single_app_security.sh -t && rm -rf $INST_SCRIPTS/misc/
# COPY ./src/common/chrome-managed-policies/urlblocklist.json /etc/opt/chrome/policies/managed/urlblocklist.json

# Setup the custom startup script that will be invoked when the container starts
#ENV LAUNCH_URL  http://kasmweb.com

COPY ./src/ubuntu/install/chrome/custom_startup.sh $STARTUPDIR/custom_startup.sh
RUN chmod +x $STARTUPDIR/custom_startup.sh

# Install Firefox
COPY ./src/ubuntu/install/firefox/ $INST_SCRIPTS/firefox/
RUN bash $INST_SCRIPTS/firefox/install_firefox.sh && rm -rf $INST_SCRIPTS/firefox/

# Install Libre Office
COPY ./src/ubuntu/install/libre_office $INST_SCRIPTS/libre_office/
RUN bash $INST_SCRIPTS/libre_office/install_libre_office.sh  && rm -rf $INST_SCRIPTS/libre_office/

### Install WINE
COPY ./src/ubuntu/install/wine $INST_SCRIPTS/wine/
RUN bash $INST_SCRIPTS/wine/install_wine.sh  && rm -rf $INST_SCRIPTS/wine/

# Pre-add Mozilla Team PPA to bypass add-apt-repository GPG keyserver timeout
# (on Ubuntu Focal the thunderbird install script calls add-apt-repository which uses
#  HKP port 11371 — often blocked; we set up the PPA via HTTPS curl instead)
RUN printf 'Package: *\nPin: release o=LP-PPA-mozillateam\nPin-Priority: 1001\n' \
        > /etc/apt/preferences.d/mozilla-firefox && \
    echo "deb https://ppa.launchpadcontent.net/mozillateam/ppa/ubuntu focal main" \
        > /etc/apt/sources.list.d/mozillateam-ppa.list && \
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x0AB215679C571D1C8325275B9BDB3D89CE49EC21" \
        -o /tmp/mozillateam.asc || \
    curl -fsSL "https://keys.openpgp.org/vks/v1/by-fingerprint/0AB215679C571D1C8325275B9BDB3D89CE49EC21" \
        -o /tmp/mozillateam.asc && \
    gpg --dearmor < /tmp/mozillateam.asc > /etc/apt/trusted.gpg.d/mozillateam.gpg && \
    rm /tmp/mozillateam.asc

# Install Thunderbird
COPY ./src/ubuntu/install/thunderbird $INST_SCRIPTS/thunderbird/
RUN bash $INST_SCRIPTS/thunderbird/install_thunderbird.sh  && rm -rf $INST_SCRIPTS/thunderbird/

# Install Thunderbird add-ons via enterprise policy (auto-installed on first launch)
RUN mkdir -p /usr/lib/thunderbird/distribution && \
    curl -sSL "https://addons.thunderbird.net/thunderbird/downloads/latest/safe-links-cleaner/addon-988025-latest.xpi" \
        -o /usr/lib/thunderbird/safe-links-cleaner.xpi && \
    curl -sSL "https://addons.thunderbird.net/thunderbird/downloads/latest/web_translate/addon-987924-latest.xpi" \
        -o /usr/lib/thunderbird/web-translate.xpi && \
    echo '{"policies":{"Extensions":{"Install":["file:///usr/lib/thunderbird/safe-links-cleaner.xpi","file:///usr/lib/thunderbird/web-translate.xpi"]}}}' \
        > /usr/lib/thunderbird/distribution/policies.json

# Install VSCode
COPY ./src/ubuntu/install/vs_code $INST_SCRIPTS/vs_code/
RUN bash $INST_SCRIPTS/vs_code/install_vs_code.sh  && rm -rf $INST_SCRIPTS/vs_code/

# Install Insomnia
COPY ./src/ubuntu/install/insomnia $INST_SCRIPTS/insomnia/
RUN bash $INST_SCRIPTS/insomnia/install_insomnia.sh  && rm -rf $INST_SCRIPTS/insomnia/

# Install IT-Tools locally (served locally via nginx on port 8088)
RUN apt-get update && apt-get install -y nginx
COPY --from=it-tools /usr/share/nginx/html /opt/it-tools
RUN mkdir -p /tmp/nginx-it-tools && \
    printf 'pid /tmp/nginx-it-tools/nginx.pid;\nerror_log /tmp/nginx-it-tools/error.log;\nevents { worker_connections 64; }\nhttp {\n    include /etc/nginx/mime.types;\n    access_log /tmp/nginx-it-tools/access.log;\n    client_body_temp_path /tmp/nginx-it-tools/client_body;\n    proxy_temp_path /tmp/nginx-it-tools/proxy;\n    fastcgi_temp_path /tmp/nginx-it-tools/fastcgi;\n    uwsgi_temp_path /tmp/nginx-it-tools/uwsgi;\n    scgi_temp_path /tmp/nginx-it-tools/scgi;\n    server {\n        listen 8088;\n        root /opt/it-tools;\n        index index.html;\n        location / { try_files $uri $uri/ /index.html; }\n    }\n}\n' \
        > /opt/it-tools-nginx.conf && \
    chmod 777 /tmp/nginx-it-tools && \
    printf '#!/bin/bash\nmkdir -p /tmp/nginx-it-tools\nnginx -c /opt/it-tools-nginx.conf\n' \
        > /opt/start-it-tools.sh && \
    chmod +x /opt/start-it-tools.sh && \
    sed -i 's|kasm_startup() {|kasm_startup() {\n    /opt/start-it-tools.sh \&|' $STARTUPDIR/custom_startup.sh
RUN printf '[Desktop Entry]\nVersion=1.0\nType=Application\nName=IT-Tools\nComment=Collection of handy online tools for developers\nExec=google-chrome http://localhost:8088\nIcon=applications-utilities\nTerminal=false\nCategories=Utility;Development;\n' \
        > $HOME/Desktop/it-tools.desktop && \
    chmod +x $HOME/Desktop/it-tools.desktop

# Install auto-unzip watcher for the Uploads folder
COPY ./auto_unzip.sh $STARTUPDIR/auto_unzip.sh
RUN chmod +x $STARTUPDIR/auto_unzip.sh && \
    sed -i 's|kasm_startup() {|kasm_startup() {\n    /dockerstartup/auto_unzip.sh \&|' $STARTUPDIR/custom_startup.sh

# Create custom browser launches for different user-agents
RUN printf '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Brave (Windows)\nComment=Brave Browser with Windows 11 user agent\nExec=brave-browser --user-agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36 Brave/125.0.0.0" --disable-features=UserAgentClientHint\nIcon=brave-browser\nTerminal=false\nCategories=Network;WebBrowser;\n' \
        > $HOME/Desktop/brave-windows.desktop && \
    chmod +x $HOME/Desktop/brave-windows.desktop && \
    printf '[Desktop Entry]\nVersion=1.0\nType=Application\nName=Brave (iOS)\nComment=Brave Browser with iPhone user agent and mobile viewport\nExec=brave-browser --user-agent="Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1" --window-size=540,960 --disable-features=UserAgentClientHint\nIcon=brave-browser\nTerminal=false\nCategories=Network;WebBrowser;\n' \
        > $HOME/Desktop/brave-ios.desktop && \
    chmod +x $HOME/Desktop/brave-ios.desktop
RUN chown -R 1000:0 $HOME/Desktop

######### End Customizations ###########

RUN chown 1000:0 $HOME
RUN $STARTUPDIR/set_user_permission.sh $HOME

ENV HOME /home/kasm-user
WORKDIR $HOME
RUN mkdir -p $HOME && chown -R 1000:0 $HOME

USER 1000
